 scanRequested=true;serviceRequestedScan(true);assert(scanRequested&&!requestScan());recordDisconnect(204);step(164000);
 assert(!connecting&&scheduledAction==0);serviceRequestedScan(true);assert(scheduledAction==1&&!scanRequested);
 // Millisecond wraparound keeps backoff and elapsed timing correct.
