 clockMs=0;requestConnection("Home","validpass",true);step(999);assert(WiFi.starts==0);step(1000);assert(connecting&&attemptsUsed==1);
 assert(!requestScan()&&prefs.getBytesLength("network")==0);
 WiFi.state=WL_CONNECTED;step(1500);assert(lastConnectMs==1500&&lastConnectAttempts==1&&!attemptArmed);
 String ssid,password;assert(loadNetwork(ssid,password)&&password=="validpass");
 // Explicit driver failure retries at +1s, without waiting for the 30s watchdog.
