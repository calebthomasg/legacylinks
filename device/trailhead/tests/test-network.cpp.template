 clockMs=113000;retryStoredNetwork();recordDisconnect(8);step(114000);recordDisconnect(8);step(114500);assert(connecting&&retryCount==0);
 // An in-progress connection retains its full watchdog.
 step(143999);assert(connecting);step(144000);assert(!connecting&&scheduledAction==2&&actionAt==145000);
 // A failed manually entered replacement never overwrites saved credentials.
 clockMs=150000;requestConnection("Home","wrongpass",true);step(151000);recordDisconnect(202);step(151100);
 assert(!connecting&&scheduledAction==0&&!saveAfterConnect&&pendingPassword.empty());assert(loadNetwork(ssid,password)&&password=="validpass");
 // Scanning while connected preserves connection. Deferred scan wins after failure.
 startSaved(160000);WiFi.state=WL_CONNECTED;step(161100);assert(requestScan());step(161450);assert(scanning&&wasConnected&&WiFi.status()==WL_CONNECTED);scanning=false;
