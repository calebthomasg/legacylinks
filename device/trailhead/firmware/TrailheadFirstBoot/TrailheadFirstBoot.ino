 String html=R"HTML(<!doctype html><meta name="viewport" content="width=device-width"><title>Trailhead Update</title><h1>Trailhead Compass</h1><p>Choose the app-only .bin. Keep device power connected.</p><input type="file" id="f" accept=".bin"><button id="upload">Upload firmware</button><progress id="progress" value="0" max="100"></progress><pre id="s"></pre><script>
const token=')HTML"+otaToken+R"HTML(';
document.getElementById('upload').onclick=()=>{
 const f=document.getElementById('f'),button=document.getElementById('upload'),s=document.getElementById('s'),p=document.getElementById('progress');
 if(!f.files.length)return;const file=f.files[0];if(file.size>4194304||!file.name.endsWith('-app.bin')){s.textContent='Choose an app-only firmware file, up to 4 MB.';return;}
 button.disabled=true;f.disabled=true;s.textContent='Uploading 0%. Keep power connected.';const xhr=new XMLHttpRequest();xhr.open('POST','/update');xhr.timeout=600000;xhr.setRequestHeader('X-Update-Token',token);
 const finish=()=>{button.disabled=false;f.disabled=false;};
 xhr.upload.onprogress=e=>{if(e.lengthComputable){p.value=Math.round(e.loaded*100/e.total);s.textContent=p.value<100?'Uploading '+p.value+'%. Keep power connected.':'Upload sent. Device is verifying and saving. Keep power connected.';}};
 xhr.onload=()=>{s.textContent=xhr.responseText||('HTTP '+xhr.status);finish();};xhr.onerror=()=>{s.textContent='Connection lost. Check the version on the device before retrying.';finish();};xhr.ontimeout=()=>{s.textContent='No reply after 10 minutes. Check the device before retrying.';finish();};const data=new FormData();data.append('firmware',file);xhr.send(data);
};</script>)HTML";server.sendHeader("Cache-Control","no-store");server.send(200,"text/html",html);
 });
