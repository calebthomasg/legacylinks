 });
 server.on("/update",HTTP_POST,[]{if(!uploadAllowed){server.send(403,"text/plain","Update not authorized.");return;}
 bool ok=uploadAllowed&&uploadComplete&&uploadOK&&!Update.hasError();server.send(ok?200:400,"text/plain",ok?"Update complete. Restarting...":"Update failed. Existing firmware remains selected.");if(ok){rebootPending=true;rebootAt=millis()+1200;}else resumeDisplay();uploadAllowed=false;
 },[]{auto &u=server.upload();if(u.status==UPLOAD_FILE_START){uploadAllowed=authenticated()&&server.header("X-Update-Token")==otaToken;uploadOK=false;uploadComplete=false;if(!uploadAllowed)return;suspendDisplay();uploadOK=Update.begin(UPDATE_SIZE_UNKNOWN,U_FLASH);}
 else if(u.status==UPLOAD_FILE_WRITE){if(uploadAllowed&&uploadOK&&Update.write(u.buf,u.currentSize)!=u.currentSize)uploadOK=false;}
 else if(u.status==UPLOAD_FILE_END){if(uploadAllowed){if(uploadOK){uploadOK=Update.end(true);uploadComplete=uploadOK;}else Update.abort();if(!uploadOK)resumeDisplay();}}
 else if(u.status==UPLOAD_FILE_ABORTED){if(uploadAllowed){Update.abort();uploadOK=false;uploadComplete=false;uploadAllowed=false;resumeDisplay();}}
 });server.begin();
}

static lv_obj_t *cloudProgress=nullptr;
static void showUpdates(){
 clearPage(UPDATES);navBackground();navTitle(4,"Firmware Updates");
 navLabel("Installed v" TRAILHEAD_VERSION " / test",83,290,&lv_font_montserrat_16);
 cloudProgress=navLabel(cloudMessage,119,320,&nav_text);
 if(cloudBusy){
  navLabel("Keep device power connected",279,305,&nav_text);
  return;
 }
 auto *menu=navMenu();
 // Keep the status above the menu in the draw order.
 lv_obj_move_foreground(cloudProgress);
 if(cloudAvailable){
  navMenuRow(menu,"Download & install",[](lv_event_t*){
   if(startCloudJob(true))otaEnabled=false;
   showUpdates();
  });
  char version[48];
  snprintf(version,sizeof(version),"Available v%s",cloudRelease.version);
  navLabel(version,312,290,&nav_text);
  navLabel(cloudRelease.notes,346,270,&lv_font_montserrat_16);
 }else{
  navMenuRow(menu,"Check for updates",[](lv_event_t*){
   startCloudJob(false);showUpdates();
  });
 }
 navMenuRow(menu,"Local upload",[](lv_event_t*){showLocalUpdates();});
 positionMenu(menu);
 backArrow([](lv_event_t*){showSettings();},navSand());
}
static void serviceCloudUpdates(uint32_t now){
 bool changed=receiveCloudEvent();
 if(changed){if(page==UPDATES){if(cloudBusy&&cloudProgress)lv_label_set_text(cloudProgress,cloudMessage);else showUpdates();}else if(page==SETTINGS)showSettings();}
 if(cloudRestart){rebootPending=true;rebootAt=now+2000;cloudRestart=false;}
 static bool wasOnline=false;static uint32_t onlineAt=0,lastCheck=0;static bool checked=false;
 bool online=WiFi.status()==WL_CONNECTED;
 if(online&&!wasOnline){onlineAt=now;checked=false;}wasOnline=online;
 if(online&&time(nullptr)>=firstValidClockTime&&!cloudBusy&&!otaEnabled&&!uploadAllowed&&!rebootPending&&!connecting&&!scanning&&!scheduledAction&&((!checked&&now-onlineAt>10000)||(checked&&now-lastCheck>21600000))){
  if(startCloudJob(false)){checked=true;lastCheck=now;if(page==UPDATES)showUpdates();}
 }
}
static bool radioStarted=false;
static void startRadio(){
 if(radioStarted)return;
 WiFi.onEvent([](WiFiEvent_t e,WiFiEventInfo_t info){
  if(e==ARDUINO_EVENT_WIFI_STA_DISCONNECTED){recordDisconnect(info.wifi_sta_disconnected.reason);diagnosticLog.printf("Wi-Fi disconnect reason: %u\n",unsigned(info.wifi_sta_disconnected.reason));}
 });
 WiFi.mode(WIFI_STA);WiFi.setAutoReconnect(false);radioStarted=true;initOTA();
 String ssid,password;credentialsVerified=loadNetwork(ssid,password);if(credentialsVerified)requestConnection(ssid,password,false,true);else wifiMessage="Choose a network to connect.";
}
#include "Petopia.h"
#include "PetopiaFirstVisit.h"
#include "DeviceSettings.h"

static void serviceNetwork(uint32_t now){
 if(scheduledAction&&int32_t(now-actionAt)>=0){
  uint8_t action=scheduledAction;scheduledAction=0;disconnectReason.store(0);
  if(action==1){
   int found=WiFi.scanNetworks(true,false);
   scanning=found==WIFI_SCAN_RUNNING;
   if(!scanning){
    populateNetworks(found);
    WiFi.scanDelete();
   }
  }
  else {attemptFailed.store(false);attemptArmed.store(true);attemptsUsed++;connectStarted=now;connecting=true;
   wl_status_t result=WiFi.begin(pendingSSID.c_str(),pendingPassword.c_str());
   if(result==WL_CONNECT_FAILED){disconnectReason.store(0);attemptFailed.store(true);}
  }
 }
 if(connecting&&WiFi.status()==WL_CONNECTED){
  attemptArmed.store(false);attemptFailed.store(false);lastConnectMs=now-connectionCycleStarted;lastConnectAttempts=attemptsUsed;lastConnectValid=true;
  connecting=false;wasConnected=true;wifiMessage="Connected";
  if(saveAfterConnect){SavedNetwork n={};n.magic=0x4c4c5731;pendingSSID.toCharArray(n.ssid,sizeof(n.ssid));pendingPassword.toCharArray(n.password,sizeof(n.password));size_t count=prefs.putBytes("network",&n,sizeof(n));diagnosticLog.println(count==sizeof(n)?"Network saved":"ERROR: network save failed");String verifySSID,verifyPassword;credentialsVerified=count==sizeof(n)&&loadNetwork(verifySSID,verifyPassword)&&verifySSID==pendingSSID&&verifyPassword==pendingPassword; if(!credentialsVerified)wifiMessage="Connected; settings save failed";}
  saveAfterConnect=false;pendingPassword="";retryCount=0;
 }
 if(connecting&&(attemptFailed.exchange(false)||now-connectStarted>=30000)){
  attemptArmed.store(false);connecting=false;lastFailureReason=disconnectReason.load();
  // Only stop the radio attempt for the watchdog path; a failure event already
  // means the driver ended its attempt. Ignore the resulting local event.
  if(now-connectStarted>=30000)esp_wifi_disconnect();
  if(retrySaved&&retryCount<2&&!scanRequested){retryCount++;scheduledAction=2;actionAt=now+1000*retryCount;}
  else {saveAfterConnect=false;pendingPassword="";retrySaved=false;wifiMessage=String("Connection failed; reason ")+lastFailureReason+"\nRetry saved Wi-Fi in Settings";}
 }
 if(wasConnected&&!scanning&&scheduledAction!=1&&WiFi.status()!=WL_CONNECTED){
  wasConnected=false;wifiMessage=String("Connection lost; reason ")+disconnectReason.load();String ssid,password;
  if(retryCount<3&&loadNetwork(ssid,password)){requestConnection(ssid,password,false,true);retryCount=0;actionAt=now+1000;}
 }
}
void setup(){
 diagnosticLog.begin(115200);diagnosticLog.println("LegacyLink Dinglehopper " TRAILHEAD_VERSION);
 WiFi.persistent(false);WiFi.mode(WIFI_OFF);prefs.begin("trailhead",false); // Before LCD starts: may initialize NVS.
 petopia::restoreCat();
 I2C_Init();delay(120);TCA9554PWR_Init(0x00);Set_EXIO(EXIO_PIN8,Low);LCD_Init();rgbActive=true;
 brightness=constrain(int(prefs.getUChar("brightness",60)),5,100);
 const unsigned count=sizeof(greetings)/sizeof(*greetings);
 unsigned previous=prefs.getUChar("greeting",255);
 greetingIndex=previous<count?(previous+1+esp_random()%(count-1))%count:esp_random()%count;
 prefs.putUChar("greeting",greetingIndex);
 startHomeClock();
 initLVGL();Set_Backlight(brightness);
 showOpen();
}
void loop(){
 uint32_t now=millis();if(!radioStarted&&now>1500)startRadio();if(rebootPending&&int32_t(now-rebootAt)>=0)ESP.restart();
 if(!rebootPending&&radioStarted&&!cloudBusy)server.handleClient();
 if(otaEnabled&&!uploadAllowed&&now-otaStarted>600000){otaEnabled=false;if(page==LOCAL_UPDATES)showLocalUpdates();}

 const bool browsingNetworks=page==NETWORKS;
 // Apply results between gestures so a refresh cannot replace a row under a finger.
 if(scanning && (!browsingNetworks || (!touchDown && !lv_obj_is_scrolling(networkList)))){
  int found=WiFi.scanComplete();
  if(found!=WIFI_SCAN_RUNNING){
   scanning=false;
   populateNetworks(found);
   WiFi.scanDelete();
  }
 }
 if(!cloudBusy)serviceNetwork(now);
 serviceHomeClock(now);
 serviceCloudUpdates(now);
 if(browsingNetworks && !cloudBusy && !otaEnabled && !scanning && !connecting && !scheduledAction && now-scanCompletedAt>=15000)scanRequested=true;
 serviceRequestedScan(browsingNetworks);
 if(now-lastStatus>1000){lastStatus=now;if(page==CONNECTION&&statusLabel)refreshConnectionStatus();if(page==DASH || page==CLOCK_VIEW)paintDial();if(page==SIGNAL)refreshSignal();}
 if(rgbActive)lv_timer_handler();delay(5);
}
