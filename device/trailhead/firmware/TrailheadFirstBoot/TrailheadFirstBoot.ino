// Reason 8 is also generated by our intentional disconnects. Let the watchdog
// handle an ambiguous remote reason 8 instead of letting a queued local event retry.
static void recordDisconnect(unsigned reason){
 disconnectReason.store(reason);
 if(attemptArmed.load()&&reason!=8)attemptFailed.store(true);
}
