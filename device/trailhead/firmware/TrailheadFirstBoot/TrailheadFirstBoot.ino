static bool authenticated(){return !cloudBusy&&!petopia::artworkInstallBusy()&&otaEnabled&&WiFi.status()==WL_CONNECTED&&server.authenticate("admin",otaPassword.c_str());}
static void initOTA(){
 char pass[17],token[33];snprintf(pass,sizeof(pass),"%08lx%08lx",(unsigned long)esp_random(),(unsigned long)esp_random());otaPassword=pass;
 snprintf(token,sizeof(token),"%08lx%08lx%08lx%08lx",(unsigned long)esp_random(),(unsigned long)esp_random(),(unsigned long)esp_random(),(unsigned long)esp_random());otaToken=token;
 const char *headers[]={"X-Update-Token"};server.collectHeaders(headers,1);
 server.on("/",HTTP_GET,[]{if(!otaEnabled){server.send(403,"text/plain","Enable updates on the device first.");return;}if(!authenticated()){server.requestAuthentication();return;}
 String html=R"HTML(<!doctype html><meta name="viewport" content="width=device-width"><title>Dinglehopper Firmware Update</title><h1>Dinglehopper Firmware Update</h1><p>Choose the app-only .bin. Keep device power connected.</p><input type="file" id="f" accept=".bin"><button id="upload">Upload firmware</button><progress id="progress" value="0" max="100"></progress><pre id="s"></pre><script>
const token=')HTML"+otaToken+R"HTML(';
document.getElementById('upload').onclick=()=>{
 const f=document.getElementById('f'),button=document.getElementById('upload'),s=document.getElementById('s'),p=document.getElementById('progress');
 if(!f.files.length)return;const file=f.files[0];if(file.size>4194304||!file.name.endsWith('-app.bin')){s.textContent='Choose an app-only firmware file, up to 4 MB.';return;}
 button.disabled=true;f.disabled=true;s.textContent='Uploading 0%. Keep power connected.';const xhr=new XMLHttpRequest();xhr.open('POST','/update');xhr.timeout=600000;xhr.setRequestHeader('X-Update-Token',token);
 const finish=()=>{button.disabled=false;f.disabled=false;};
 xhr.upload.onprogress=e=>{if(e.lengthComputable){p.value=Math.round(e.loaded*100/e.total);s.textContent=p.value<100?'Uploading '+p.value+'%. Keep power connected.':'Upload sent. Device is verifying and saving. Keep power connected.';}};
 xhr.onload=()=>{s.textContent=xhr.responseText||('HTTP '+xhr.status);finish();};xhr.onerror=()=>{s.textContent='Connection lost. Check the version on the device before retrying.';finish();};xhr.ontimeout=()=>{s.textContent='No reply after 10 minutes. Check the device before retrying.';finish();};const data=new FormData();data.append('firmware',file);xhr.send(data);
};</script>)HTML";server.sendHeader("Cache-Control","no-store");server.send(200,"text/html",html);
 });
 server.on("/update",HTTP_POST,[]{if(!uploadAllowed){server.send(403,"text/plain","Update not authorized.");return;}
 bool ok=uploadAllowed&&uploadComplete&&uploadOK&&!Update.hasError();server.send(ok?200:400,"text/plain",ok?"Update complete. Restarting...":"Update failed. Existing firmware remains selected.");if(ok){rebootPending=true;rebootAt=millis()+1200;}else resumeDisplay();uploadAllowed=false;
 },[]{auto &u=server.upload();if(u.status==UPLOAD_FILE_START){uploadAllowed=authenticated()&&server.header("X-Update-Token")==otaToken;uploadOK=false;uploadComplete=false;if(!uploadAllowed)return;suspendDisplay();uploadOK=Update.begin(UPDATE_SIZE_UNKNOWN,U_FLASH);}
 else if(u.status==UPLOAD_FILE_WRITE){if(uploadAllowed&&uploadOK&&Update.write(u.buf,u.currentSize)!=u.currentSize)uploadOK=false;}
 else if(u.status==UPLOAD_FILE_END){if(uploadAllowed){if(uploadOK){uploadOK=Update.end(true);uploadComplete=uploadOK;}else Update.abort();if(!uploadOK)resumeDisplay();}}
 else if(u.status==UPLOAD_FILE_ABORTED){if(uploadAllowed){Update.abort();uploadOK=false;uploadComplete=false;uploadAllowed=false;resumeDisplay();}}
 });server.begin();
}

