static lv_obj_t *keyButtons[30]={};static bool upperCase=false;static int keyPage=0;
static const char *SYMBOLS="0123456789!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~";
static void updateKeys(){
 for(int i=0;i<30;i++){
  String text;
  if(i<26){if(keyPage==0)text=String(char((upperCase?'A':'a')+i));else {int pos=(keyPage-1)*26+i;if(pos<(int)strlen(SYMBOLS))text=String(SYMBOLS[pos]);}}
  else if(i==26)text=keyPage?"ABC":(upperCase?"abc":"ABC");
  else if(i==27)text=keyPage?"More":"123";
  else if(i==28)text="Space";else text="Del";
  lv_label_set_text(lv_obj_get_child(keyButtons[i],0),text.c_str());
  if(text.length())lv_obj_clear_state(keyButtons[i],LV_STATE_DISABLED);else lv_obj_add_state(keyButtons[i],LV_STATE_DISABLED);
 }
}
static void keyPressed(lv_event_t *e){
 int i=(uintptr_t)lv_event_get_user_data(e);
 if(i==26){if(keyPage)keyPage=0;else upperCase=!upperCase;updateKeys();}
 else if(i==27){keyPage=keyPage==0?1:(keyPage==1?2:1);updateKeys();}
 else if(i==28)lv_textarea_add_text(passwordBox," ");
 else if(i==29)lv_textarea_del_char(passwordBox);
 else if(keyPage==0){char text[2]={char((upperCase?'A':'a')+i),0};lv_textarea_add_text(passwordBox,text);}
 else {int pos=(keyPage-1)*26+i;if(pos<(int)strlen(SYMBOLS)){char text[2]={SYMBOLS[pos],0};lv_textarea_add_text(passwordBox,text);}}
}
